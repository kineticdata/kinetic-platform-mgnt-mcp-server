# Copy to .env and fill in. .env is gitignored — never commit real credentials,
# and never put them in your MCP client config either.
#
# Load it with an ABSOLUTE path (Node >= 20.6.0):
#   node --env-file=/absolute/path/to/kinetic-platform-mgnt-mcp/.env \
#        /absolute/path/to/kinetic-platform-mgnt-mcp/dist/index.js --stdio
#
# A RELATIVE --env-file path resolves against the MCP client's working
# directory, not this directory, and will silently load nothing.

# ── Kinetic space credentials (required for API calls) ──────────────────────
KINETIC_SERVER_URL=https://<space-slug>.kinops.io
KINETIC_USERNAME=<username>
KINETIC_PASSWORD=<password>

# Optional agent slug, retained in the session config for compatibility.
# KINETIC_AGENT_SLUG=system

# Allow self-signed certificates (development only).
# KINETIC_ALLOW_SELF_SIGNED=false

# ── Tool surface ───────────────────────────────────────────────────────────
# slim (default) | consolidated | contexts | full
# KINETIC_MCP_MODE=slim

# Context allowlist for consolidated/contexts mode. Empty means all.
# Valid: space, kapp, form, submission, user, team, model, category, fileResource, integrator
# KINETIC_MCP_CONTEXTS=form,submission,space

# Tool naming for contexts/full mode: alias (default) | core | both
# KINETIC_MCP_TOOL_NAMES=alias

# ── HTTP/SSE mode only ─────────────────────────────────────────────────────
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_HTTP_USER=<http-basic-user>
# MCP_HTTP_PASS=<http-basic-pass>

# ── Used only by scripts/sync-oas.js ───────────────────────────────────────
# KINETIC_OAS_SOURCE=../oas
